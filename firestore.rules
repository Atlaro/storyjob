rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    match /resonance_events/{eventId} {
      allow create: if request.auth != null && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
      allow read: if false;
    }

    match /resonance_pairs/{pairId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.partyA || request.auth.uid == resource.data.partyB);
      allow update: if request.auth != null && (request.auth.uid == resource.data.partyA || request.auth.uid == resource.data.partyB) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outcomeStatus', 'outcomeReportedAt']);
      allow create, delete: if false;
    }

    match /culture_clusters/{clusterId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}